# ---- Smart Retail Platform: environment configuration ----------------------
# Copy to .env and adjust values. NEVER commit the real .env file.

# Application
ENV=development
DEBUG=false
APP_NAME=Smart Retail Customer Intelligence API
APP_VERSION=1.0.0

# Security
API_KEY=change-me-in-production
API_KEY_NAME=X-API-Key
CORS_ORIGINS=*

# Database
# SQLite (default):
DATABASE_URL=sqlite:///./data/retail.db
# PostgreSQL example (Railway/Render/Heroku):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/retail
DB_ECHO=false

# Model artifacts
# MODEL_DIR=models/artifacts

# Face recognition
FACE_ENCODING_MODEL=cnn
FACE_TOLERANCE=0.5

# Dashboard (Streamlit) reads these via streamlit secrets or env
DASHBOARD_API_BASE=http://localhost:8000
